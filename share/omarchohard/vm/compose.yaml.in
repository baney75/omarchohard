# Generated by `omarchohard desktop install`. Based on WinApps' compose.yaml.
name: "omarchohard"
volumes:
  data:
services:
  windows:
    image: ghcr.io/dockur/windows:latest
    container_name: WinApps
    environment:
      VERSION: "@VERSION@"
      RAM_SIZE: "@RAM@"
      CPU_CORES: "4"
      DISK_SIZE: "80G"
      USERNAME: "@USER@"
      PASSWORD: "@PASS@"
      HOME: "${HOME}"
    ports:
      - "127.0.0.1:8006:8006"
      - "127.0.0.1:3389:3389/tcp"
      - "127.0.0.1:3389:3389/udp"
    cap_add:
      - NET_ADMIN
      - NET_RAW
    stop_grace_period: 120s
    restart: on-failure
    volumes:
      - data:/storage
      - ${HOME}:/shared
      - ./oem:/oem
    devices:
      - /dev/kvm
      - /dev/net/tun
