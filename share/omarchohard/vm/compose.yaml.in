# Generated by `omarchohard desktop install`. Based on WinApps' compose.yaml.
name: "omarchohard"
services:
  windows:
    # A fixed dockur/windows release (v6.06, 2026-10-05), so a new image never
    # changes a working VM unasked.
    image: ghcr.io/dockur/windows:6.06
    container_name: WinApps
    environment:
      VERSION: "@VERSION@"
      RAM_SIZE: "@RAM@"
      CPU_CORES: "4"
      DISK_SIZE: "80G"
      # Parallel connections for dockur's download of the Windows image
      # (aria2; 1 to 16, dockur's default is 4).
      CONNECTIONS: "16"
      USERNAME: "@USER@"
      PASSWORD: "@PASS@"
      HOME: "${HOME}"
    ports:
      - "127.0.0.1:8006:8006"
      - "127.0.0.1:3389:3389/tcp"
      - "127.0.0.1:3389:3389/udp"
    cap_add:
      - NET_ADMIN
      - NET_RAW
    stop_grace_period: 120s
    restart: on-failure
    volumes:
      - ./storage:/storage
      - ${HOME}:/shared
      - ./oem:/oem
    devices:
      - /dev/kvm
      - /dev/net/tun
