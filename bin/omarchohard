#!/usr/bin/env bash
# omarchohard: Microsoft 365 on Omarchy (Arch + Hyprland).
# https://github.com/baney75/omarchohard
set -euo pipefail

OH_SELF=$(readlink -f "${BASH_SOURCE[0]}")
OH_ROOT=${OMARCHOHARD_ROOT:-$(dirname "$(dirname "$OH_SELF")")}
OH_LIB=$OH_ROOT/lib/omarchohard
OH_SHARE=$OH_ROOT/share/omarchohard

for module in common apps browser integrate open onedrive release doctor desktop setup agent share; do
  # shellcheck source=/dev/null
  source "$OH_LIB/$module.sh"
done

usage() {
  cat <<EOF
omarchohard $(oh_version) - Microsoft 365 on Omarchy

Usage: omarchohard <command> [options]

Start here
  setup                  Guided setup: Office tier, browser, sign-in, OneDrive, check.
                         Agents: setup --yes [--tier desktop|web] [--browser B] [--shared|--isolated]
                         [--email E] [--no-mail] [--apps LIST] [--files microsoft|all|LIST]
                         [--onedrive rclone|abraunegg|none] [--prewarm on|off] [--optimize]

Everyday
  install [--isolated] [--no-mail] [--prewarm] [--apps word,excel,teams|all]
                         Add Word, Excel, PowerPoint, Outlook, OneNote, Teams
                         and OneDrive to the launcher and set file handlers
  login [--email ADDR]   Open the Microsoft sign-in page once (SSO)
  launch APP [URL]       Open or focus an app (word, excel, powerpoint,
                         outlook, onenote, teams, onedrive, m365)
  open FILE|URL          Open a document in the right app
  doctor [--json]        Check every launcher, handler and service
  share [--link] FILE    Share through OneDrive (also in Files: right-click, Scripts)
  add APP... | remove APP...
                         Choose which apps are installed (teams, onenote, ...)
  files [microsoft|all|LIST]
                         Which files open in Office: Microsoft formats only
                         (default), all, or Microsoft plus odt,ods,odp,rtf,csv
  addins [APP]           Find Office Add-ins (they work in the web apps)
  uninstall [--purge]    Remove everything install added and restore handlers

Files and sync
  onedrive setup [--client rclone|abraunegg] [--dir DIR]
  onedrive status | sync | web-root URL | start | stop | remove

Speed and agents
  probe [--json]         What this device has and what omarchohard recommends
  optimize [--apply]     Tune cache size and prewarm for this device
  prewarm on|off|status  Keep the browser resident so apps open in ~0.2 s

Desktop Office (the real Windows apps, in a Windows VM you never see)
  desktop check | install [--wait] | status [--json] | wait | up | down | apps
  desktop run FILE       Open a file in Windows (add-ins, installers, documents)
  desktop slim           Shrink the VM's disk: home apps, update downloads, compression
  desktop update [--channel current|monthly|semi-annual] [--to VERSION]
  desktop activate [--key-file F] | prefer on|off | remove [--delete-vm]

Releases
  channel [stable|nightly|dev]   Show or switch the release channel
  update [--check]               Update to the newest build on the channel
  version

Environment: OMARCHOHARD_DRY_RUN=1 prints commands instead of running them.
EOF
}

main() {
  local cmd=${1:-help}
  (($#)) && shift
  case $cmd in
  setup) oh_setup "$@" ;;
  probe) oh_probe "$@" ;;
  optimize) oh_optimize "$@" ;;
  addins | add-ins) oh_addins "$@" ;;
  share) oh_share "$@" ;;
  add) oh_apps_change add "$@" ;;
  remove) oh_apps_change remove "$@" ;;
  files) oh_files "$@" ;;
  install) oh_install "$@" ;;
  uninstall) oh_uninstall "$@" ;;
  login) oh_login "$@" ;;
  launch) oh_launch "$@" ;;
  open) oh_open "$@" ;;
  doctor) oh_doctor "$@" ;;
  onedrive) oh_onedrive "$@" ;;
  prewarm) oh_prewarm "$@" ;;
  desktop) oh_desktop "$@" ;;
  channel) oh_channel "$@" ;;
  update) oh_update "$@" ;;
  version | --version | -V) echo "omarchohard $(oh_version)" ;;
  help | --help | -h) usage ;;
  *)
    oh_err "unknown command: $cmd"
    usage >&2
    exit 2
    ;;
  esac
}

main "$@"
